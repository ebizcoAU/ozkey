# S−1 (ozkey-50 §8.2). Copy to .env beside server.js, then `chmod 600 .env`.
# .env is gitignored; never commit real values. Env vars override this file.
# NODE_ENV=production makes every secret below mandatory.
OZLOCK_DB_PASSWORD=<set-me>
# Required in production (>= 32 chars); lab falls back to a warned lab-only value.
OZLOCK_JWT_SECRET=<set-me>
# S1c: Wi-Fi the provision payload hands a lock. Required, no default.
PROVISION_WIFI_SSID=<set-me>
PROVISION_WIFI_PASSWORD=<set-me>
