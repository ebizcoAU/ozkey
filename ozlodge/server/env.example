# S−1 (ozkey-50 §8.2). Copy to .env beside server.js, then `chmod 600 .env`.
# .env is gitignored; never commit real values. Env vars override this file.
# NODE_ENV=production makes every secret below mandatory.
OZLODGE_DB_PASSWORD=<set-me>
# Required in production (>= 32 chars); unset in lab leaves /pms/* writes open.
OZLODGE_PMS_SECRET=<set-me>
