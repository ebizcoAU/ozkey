# S−1 (ozkey-50 §8.2). Copy to .env beside server.js, then `chmod 600 .env`.
# .env is gitignored; never commit real values. Env vars override this file.
# NODE_ENV=production makes every secret below mandatory.
OZLOCK_DB_PASSWORD=<set-me>
# Required in production (>= 32 chars); lab falls back to a warned lab-only value.
OZLOCK_JWT_SECRET=<set-me>
# S1c: Wi-Fi the provision payload hands a lock. Required, no default.
PROVISION_WIFI_SSID=<set-me>
PROVISION_WIFI_PASSWORD=<set-me>
# OZLOCK-AUTH-1: REST API caller keys, one per client, "name:key,name:key".
# name = a-z 0-9 _ - (max 32); key >= 32 chars (e.g. `openssl rand -hex 32`).
# Every /ozlockserv/api route except GET /health needs `Authorization: Bearer <key>`.
# Boot is refused without keys. Lab only: OZLOCK_API_OPEN=1 serves without a key
# (refused in production, and refused if OZLOCK_API_KEYS is also set).
OZLOCK_API_KEYS=<set-me>
# OZLOCK_API_OPEN=1
# OZLOCK-AUTH-1 (R2): listen address (unset = all interfaces; 127.0.0.1 behind
# a reverse proxy) and a dedicated MySQL user (unset = root).
# OZLOCK_BIND=127.0.0.1
# OZLOCK_DB_USER=ozlock
